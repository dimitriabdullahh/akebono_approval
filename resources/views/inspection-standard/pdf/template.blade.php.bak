    <style>
        @page {
            size: A4 portrait;
            margin: 8mm 10mm;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            font-size: 8px;
            color: #000;
            line-height: 1.2;
        }
        
        .page {
            page-break-after: always;
            width: 100%;
            border: 3px solid #000;
            padding: 8px;
            min-height: 277mm;
        }
        
        .page:last-child {
            page-break-after: avoid;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 4px;
        }
        
        td, th {
            border: 1px solid #000;
            padding: 2px 4px;
            vertical-align: middle;
            font-size: 7px;
        }
        
        .bold { font-weight: bold; }
        .center { text-align: center; }
        .small { font-size: 6px; }
        
        /* Title Block */
        .title-block {
            text-align: center;
            padding: 30px 20px;
            border: 1px solid #000;
            margin-bottom: 4px;
        }
        
        .title-block .company {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 8px;
        }
        
        .title-block .doc-title {
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 4px;
        }
        
        .title-block .subtitle {
            font-size: 8px;
            font-style: italic;
            margin-bottom: 15px;
        }
        
        .title-block .part-info {
            text-align: left;
            margin: 0 auto;
            width: 70%;
        }
        
        .title-block .part-info div {
            margin-bottom: 6px;
            border-bottom: 1px solid #000;
            padding-bottom: 2px;
            font-size: 8px;
        }
        
        .signature-box {
            height: 55px;
            vertical-align: bottom;
        }
        
        .checkbox {
            display: inline-block;
            width: 11px;
            height: 11px;
            border: 2px solid #000;
            margin-right: 5px;
            vertical-align: middle;
        }
        
        /* Page 2 & 3 */
        .drawing-area {
            border: 2px solid #000;
            min-height: 480px;
            padding: 10px;
            margin-bottom: 4px;
            background-color: #fafafa;
        }
        
        .drawing-item {
            margin-bottom: 8px;
            padding: 6px;
            border: 1px solid #ccc;
            background: #fff;
        }
        
        .drawing-image {
            text-align: center;
            margin-top: 6px;
        }
        
        .inspection-row {
            height: 55px;
        }
        
        .revision-row {
            height: 32px;
        }
        
        .approval-signature-row {
            height: 50px;
        }
    </style>
</head>
