            <div class="card-header bg-light">
                <h5 class="mb-0">Visualization & Images</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Image - Image of Packaging -->
                    <div class="col-md-6 mb-4">
                        <label class="form-label">Image of Packaging</label>
                        <div class="image-upload-zone mb-2" data-image-type="image_of_packaging">
                            <input type="file" class="form-control d-none" name="images_of_packaging[]" accept="image/jpeg,image/png" data-image-type="image_of_packaging" multiple>
                            <div class="upload-placeholder">
