        <!-- Action Buttons -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-cyan" id="saveDraftBtn" onclick="saveDraft()" disabled>Save Draft</button>
                    <button type="button" class="btn btn-blue" id="submitBtn" onclick="submitForm()" disabled>Submit</button>
                </div>
                <div id="formLoadingStatus" class="text-center mt-2">
                    <small class="text-warning"><i class="ti ti-loader-3"></i> Loading form...</small>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
// ===== UTILITY FUNCTIONS (Available Globally) =====
function formatFileSize(bytes) {
    if (!bytes) return 'Unknown';
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    if (bytes === 0) return '0 Byte';
    const i = parseInt(Math.floor(Math.log(bytes) / Math.log(1024)));
    return Math.round(bytes / Math.pow(1024, i), 2) + ' ' + sizes[i];
}
window.formatFileSize = formatFileSize;

// ===== LOGO UPLOAD HANDLER - Setup immediately (before DOMContentLoaded) =====
let uploadedLogoPath = null;
let logoFileInput = null;
let logoUploadZone = null;
let logoUploadInitialized = false;
let logoInitAttempts = 0;

function initializeLogoUpload() {
    if (logoUploadInitialized) {
        console.log('✅ Logo upload already initialized, skipping');
        return;
    }
    
    logoInitAttempts++;
    logoUploadZone = document.getElementById('logoUploadZone');
    logoFileInput = document.getElementById('logoFileInput');
    
    console.log(`🔴 ATTEMPT ${logoInitAttempts}: Logo upload init - Zone found?`, !!logoUploadZone, 'Input found?', !!logoFileInput);
    console.log('📍 Document readyState:', document.readyState);
    
    if (!logoUploadZone || !logoFileInput) {
        if (logoInitAttempts < 10) {
            console.warn('⚠️ Logo elements not found. Retrying in 50ms... (attempt ' + logoInitAttempts + '/10)');
            setTimeout(initializeLogoUpload, 50);
        } else {
            console.error('❌ Logo elements still not found after 10 attempts!');
        }
        return;
    }
    
    // Make sure zone is clickable
    logoUploadZone.style.cursor = 'pointer';
    console.log('🖱️ Zone cursor set to pointer');
    
    // Click handler
    logoUploadZone.addEventListener('click', function(e) {
        console.log('📁 CLICK EVENT FIRED on logoUploadZone:', e);
        e.preventDefault();
        e.stopPropagation();
        logoFileInput.click();
        console.log('✅ File input clicked programmatically');
    });
    
    // Drag over
    logoUploadZone.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.stopPropagation();
        logoUploadZone.style.borderColor = '#2563EB';
        logoUploadZone.style.backgroundColor = '#DBEAFE';
    });
    
    // Drag leave
    logoUploadZone.addEventListener('dragleave', function(e) {
        e.preventDefault();
        e.stopPropagation();
        logoUploadZone.style.borderColor = '#CBD5E1';
        logoUploadZone.style.backgroundColor = '#F8FAFC';
    });
    
    // Drop
    logoUploadZone.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        logoUploadZone.style.borderColor = '#CBD5E1';
        logoUploadZone.style.backgroundColor = '#F8FAFC';
        const files = e.dataTransfer.files;
        console.log('📥 Drop event - files:', files.length);
        if (files.length > 0) {
            handleLogoUpload(files[0]);
        }
    });
    
    // File input change
    logoFileInput.addEventListener('change', function(e) {
        console.log('📄 File input change event - files:', e.target.files.length);
        if (e.target.files.length > 0) {
            handleLogoUpload(e.target.files[0]);
        }
    });
    
    logoUploadInitialized = true;
    console.log('✅ ALL Logo upload handlers attached successfully');
    console.log('🎯 Logo upload zone is now ready for clicks');
}

async function handleLogoUpload(file) {
    console.log('📤 Logo upload started:', file.name);
    
    // Validate file
    if (!file.type.match('image/(jpeg|jpg|png|gif|webp)')) {
        Swal.fire('Error', 'File is not a valid image format. Please use JPG, PNG, GIF, or WebP.', 'error');
        return;
    }
    
    if (file.size > 5 * 1024 * 1024) {
        Swal.fire('Error', 'File exceeds 5MB limit', 'error');
        return;
    }

    // Create preview
    const reader = new FileReader();
    reader.onload = function(e) {
        const previewDiv = document.getElementById('logoPreview');
        previewDiv.innerHTML = `<img src="${e.target.result}" style="max-height: 150px; max-width: 100%; object-fit: contain;" alt="Logo Preview">`;
        uploadedLogoPath = e.target.result;
    };
    reader.readAsDataURL(file);

    // Show uploaded logo info
    const logoContainer = document.getElementById('uploadedLogoContainer');
    logoContainer.innerHTML = `
        <div class="card mt-2">
            <div class="card-body p-2">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="ti ti-check-circle" style="color: #22c55e; font-size: 24px; margin-right: 10px;"></i>
                        <div>
                            <small class="d-block"><strong>${file.name}</strong></small>
                            <small class="text-muted">${formatFileSize(file.size)} - Ready to upload</small>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-danger" onclick="clearLogoUpload()">
                        <i class="ti ti-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    `;
}

function clearLogoUpload() {
    if (logoFileInput) logoFileInput.value = '';
    uploadedLogoPath = null;
    const preview = document.getElementById('logoPreview');
    if (preview) preview.innerHTML = '<span class="text-muted" style="font-size: 12px;">Logo preview will appear here</span>';
    const container = document.getElementById('uploadedLogoContainer');
    if (container) container.innerHTML = '';
}

// Expose logo functions to global scope
window.clearLogoUpload = clearLogoUpload;
window.handleLogoUpload = handleLogoUpload;

// Initialize logo upload when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeLogoUpload);
} else {
    initializeLogoUpload();
}

// ===== END LOGO UPLOAD HANDLER =====

// ==========================================
// DEFINE ALL MATERIAL TABLE FUNCTIONS FIRST
// ==========================================

let materials = [];

function initializeMaterialsTable() {
    console.log('initializeMaterialsTable called');
    const tbody = document.getElementById('materialsTableBody');
    console.log('materialsTableBody element exists?', !!tbody);
    
    if (!tbody) {
        console.error('❌ CRITICAL: materialsTableBody element not found!');
        // Retry after a short delay if DOM not ready
        setTimeout(() => {
            const retryTbody = document.getElementById('materialsTableBody');
            if (retryTbody) {
                initializeMaterialsTable();
            }
        }, 100);
        return;
    }
    
    materials = [];
    for (let i = 0; i < 6; i++) {
        materials.push({
            part_no: '',
            part_name: '',
            supplier: '',
            qty: ''
        });
    }
    console.log('✓ Materials initialized:', materials);
    renderMaterialsTable();
}

function addMaterialRow() {
    materials.push({
        part_no: '',
        part_name: '',
        supplier: '',
        qty: ''
    });
    renderMaterialsTable();
}

function removeMaterialRow(index) {
    if (materials.length > 6) {
        materials.splice(index, 1);
        renderMaterialsTable();
    } else {
        Swal.fire('Error', 'Minimum 6 rows required. Please clear the content instead of deleting the row.', 'warning');
    }
}

function updateMaterial(index, field, value) {
    if (materials[index]) {
        materials[index][field] = value;
        console.log('Material updated:', materials[index]);
    }
}

// Expose all material functions to global scope
window.addMaterialRow = addMaterialRow;
window.removeMaterialRow = removeMaterialRow;
window.updateMaterial = updateMaterial;
window.initializeMaterialsTable = initializeMaterialsTable;

function renderMaterialsTable() {
    console.log('renderMaterialsTable called with materials:', materials);
    const tbody = document.getElementById('materialsTableBody');
    
    if (!tbody) {
        console.error('❌ CRITICAL: materialsTableBody element not found in renderMaterialsTable!');
        return;
    }
    
    console.log('✓ tbody found, clearing...');
    tbody.innerHTML = '';

    // Ensure we always have at least 6 rows
    while (materials.length < 6) {
        materials.push({
            part_no: '',
            part_name: '',
            supplier: '',
            qty: ''
        });
    }

    console.log('✓ Rendering', materials.length, 'rows');
    materials.forEach((material, index) => {
        const row = document.createElement('tr');
        
        // Number cell
        const cellNum = document.createElement('td');
        cellNum.style.textAlign = 'center';
        cellNum.style.verticalAlign = 'middle';
        cellNum.textContent = (index + 1);
        row.appendChild(cellNum);
        
        // Part No cell
        const cellPartNo = document.createElement('td');
        const inputPartNo = document.createElement('input');
        inputPartNo.type = 'text';
        inputPartNo.className = 'form-control form-control-sm material-part-no';
        inputPartNo.value = material.part_no || '';
        inputPartNo.onchange = function() { window.updateMaterial(index, 'part_no', this.value); };
        cellPartNo.appendChild(inputPartNo);
        row.appendChild(cellPartNo);
        
        // Part Name cell
        const cellPartName = document.createElement('td');
        const inputPartName = document.createElement('input');
        inputPartName.type = 'text';
        inputPartName.className = 'form-control form-control-sm material-part-name';
        inputPartName.value = material.part_name || '';
        inputPartName.onchange = function() { window.updateMaterial(index, 'part_name', this.value); };
        cellPartName.appendChild(inputPartName);
        row.appendChild(cellPartName);
        
        // Supplier cell
        const cellSupplier = document.createElement('td');
        const inputSupplier = document.createElement('input');
        inputSupplier.type = 'text';
        inputSupplier.className = 'form-control form-control-sm material-supplier';
        inputSupplier.value = material.supplier || '';
        inputSupplier.onchange = function() { window.updateMaterial(index, 'supplier', this.value); };
        cellSupplier.appendChild(inputSupplier);
        row.appendChild(cellSupplier);
        
        // Qty cell
        const cellQty = document.createElement('td');
        const inputQty = document.createElement('input');
        inputQty.type = 'number';
        inputQty.className = 'form-control form-control-sm material-qty';
        inputQty.value = material.qty || '';
        inputQty.min = '0';
        inputQty.onchange = function() { window.updateMaterial(index, 'qty', this.value); };
        cellQty.appendChild(inputQty);
        row.appendChild(cellQty);
        
        // Action cell
        const cellAction = document.createElement('td');
        cellAction.style.textAlign = 'center';
        cellAction.style.verticalAlign = 'middle';
        if (index >= 6) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-sm btn-danger';
            btn.title = 'Delete Row';
            btn.innerHTML = '<i class="ti ti-trash"></i>';
            btn.onclick = function(e) { e.preventDefault(); window.removeMaterialRow(index); };
            cellAction.appendChild(btn);
        }
        row.appendChild(cellAction);
        
        tbody.appendChild(row);
    });
    console.log('✓ Materials table rendered successfully with', materials.length, 'rows');
}

// Expose renderMaterialsTable to window
window.renderMaterialsTable = renderMaterialsTable;

// ===== START DOMContentLoaded EVENT =====
document.addEventListener('DOMContentLoaded', function() {
    console.log('🟢 DOMContentLoaded event fired!');
    console.log('🟢 materials variable:', materials);
    console.log('🟢 initializeMaterialsTable function:', typeof initializeMaterialsTable);
    
    const token = '{{ $token }}';
    window.uploadedImages = {
        image_of_packaging: [],
        part_identification_point: []
    };

    // Initialize materials table immediately
    console.log('🟡 About to call initializeMaterialsTable()');
    initializeMaterialsTable();
    console.log('🟢 initializeMaterialsTable() completed');
    
    // Load form data
    loadFormData();

    async function loadFormData() {
        try {
            console.log('Loading form data with token:', token);
            const response = await fetch(`/api/packaging-standards/${token}`);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            console.log('API Response:', result);
            
            if (result.success) {
                window.packagingStandardId = result.data.packagingStandardId;
                console.log('PackagingStandardId set to:', window.packagingStandardId);
                console.log('Full response data:', result.data);
                populateForm(result.data);
                
                // Load existing images
                if (result.data.images) {
                    loadExistingImages(result.data.images);
                }
                
                // Enable buttons
                document.getElementById('saveDraftBtn').disabled = false;
                document.getElementById('submitBtn').disabled = false;
                document.getElementById('formLoadingStatus').innerHTML = '<small class="text-success"><i class="ti ti-check"></i> Form loaded successfully</small>';
            } else {
                throw new Error(result.error || 'Failed to load form data');
            }
        } catch (error) {
            console.error('Error loading form:', error);
            document.getElementById('formLoadingStatus').innerHTML = '<small class="text-danger"><i class="ti ti-alert-triangle"></i> Failed to load form: ' + error.message + '</small>';
            Swal.fire('Error', 'Failed to load form data: ' + error.message, 'error');
        }
    }

    function loadExistingImages(images) {
        if (images.image_of_packaging && images.image_of_packaging.length > 0) {
            window.uploadedImages.image_of_packaging = images.image_of_packaging;
            displayUploadedImages('image_of_packaging');
        }
        
        if (images.part_identification_point && images.part_identification_point.length > 0) {
            window.uploadedImages.part_identification_point = images.part_identification_point;
            displayUploadedImages('part_identification_point');
        }
    }

    function populateForm(data) {
        console.log('🔵 populateForm called with data:', data);
        
        // Company Logo
        if (data.company_logo) {
            uploadedLogoPath = data.company_logo;
            const previewDiv = document.getElementById('logoPreview');
            previewDiv.innerHTML = `<img src="${data.company_logo}" style="max-height: 150px; max-width: 100%; object-fit: contain;" alt="Company Logo">`;
        }

        // General Information
        console.log('🔵 Populating General Information...');
        if (data.document_no) document.getElementById('document_no').value = data.document_no;
        if (data.revision) document.getElementById('revision').value = data.revision;
        if (data.date) document.getElementById('date').value = data.date;
        
        // CRITICAL FIELDS - with detailed logging
        console.log('🔵 Setting Model field:', data.model);
        if (data.model) {
            const modelEl = document.getElementById('model');
            if (modelEl) {
                modelEl.value = data.model;
                console.log('✅ Model set to:', modelEl.value);
            } else {
                console.error('❌ Model element not found!');
            }
        }
        
        console.log('🔵 Setting Part No field:', data.part_no);
        if (data.part_no) {
            const partNoEl = document.getElementById('part_no');
            if (partNoEl) {
                partNoEl.value = data.part_no;
                console.log('✅ Part No set to:', partNoEl.value);
            } else {
                console.error('❌ Part No element not found!');
            }
        }
        
        console.log('🔵 Setting Part Name field:', data.part_name);
        if (data.part_name) {
            const partNameEl = document.getElementById('part_name');
            if (partNameEl) {
                partNameEl.value = data.part_name;
                console.log('✅ Part Name set to:', partNameEl.value);
            } else {
                console.error('❌ Part Name element not found!');
            }
        }
        
        console.log('🔵 Setting Supplier Name field:', data.supplier_name);
        if (data.supplier_name) {
            const supplierNameEl = document.getElementById('supplier_name');
            if (supplierNameEl) {
                supplierNameEl.value = data.supplier_name;
                console.log('✅ Supplier Name set to:', supplierNameEl.value);
            } else {
                console.error('❌ Supplier Name element not found!');
            }
        }
        
        if (data.qty) document.getElementById('qty').value = data.qty;

        // Packaging Specifications
        if (data.packaging_type) document.getElementById('packaging_type').value = data.packaging_type;
        if (data.packaging_size_mm) document.getElementById('packaging_size_mm').value = data.packaging_size_mm;
        if (data.packaging_lot_pcs_box) document.getElementById('packaging_lot_pcs_box').value = data.packaging_lot_pcs_box;
        if (data.net_weight_g_pc) document.getElementById('net_weight_g_pc').value = data.net_weight_g_pc;
        if (data.total_weight_kg_box) document.getElementById('total_weight_kg_box').value = data.total_weight_kg_box;

        // Load materials - update existing table if data exists
        if (data.materials && Array.isArray(data.materials) && data.materials.length > 0) {
            console.log('Updating materials with data:', data.materials);
            // Replace materials array with data
            materials = [];
            data.materials.forEach(mat => {
                materials.push({
                    part_no: mat.part_no || '',
                    part_name: mat.part_name || '',
                    supplier: mat.supplier || '',
                    qty: mat.qty || ''
                });
            });
            // Ensure we have at least 6 rows
            while (materials.length < 6) {
                materials.push({
                    part_no: '',
                    part_name: '',
                    supplier: '',
                    qty: ''
                });
            }
            renderMaterialsTable();
        }
    }

    // Define handleFileUpload function FIRST before using it
    window.handleFileUpload = async function handleFileUpload(files, imageType) {
        if (!window.packagingStandardId) {
            Swal.fire('Error', 'Form not initialized. Please refresh the page.', 'error');
            console.error('packagingStandardId is not set');
            return;
        }

        const fileArray = Array.from(files);
        console.log('Uploading files:', fileArray, 'Type:', imageType, 'PS ID:', window.packagingStandardId);
        
        for (const file of fileArray) {
            // Validate file
            if (!file.type.match('image/(jpeg|jpg|png)')) {
                Swal.fire('Error', `File ${file.name} is not a valid image format`, 'error');
                continue;
            }
            
            if (file.size > 10 * 1024 * 1024) {
                Swal.fire('Error', `File ${file.name} exceeds 10MB limit`, 'error');
                continue;
            }

            // Upload file
            const formData = new FormData();
            formData.append('image', file);
            formData.append('image_type', imageType);

            try {
                console.log('Uploading to:', `/api/packaging-standards/${window.packagingStandardId}/upload-image`);
                
                const response = await fetch(`/api/packaging-standards/${window.packagingStandardId}/upload-image`, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    body: formData
                });

                const result = await response.json();
                console.log('Upload result:', result);
                
                if (result.success) {
                    // Add to uploaded images array
                    window.uploadedImages[imageType].push(result.image);
                    displayUploadedImages(imageType);
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: `${file.name} uploaded successfully`,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                } else {
                    Swal.fire('Error', result.message || `Failed to upload ${file.name}`, 'error');
                }
            } catch (error) {
                console.error('Error uploading image:', error);
                Swal.fire('Error', `Failed to upload ${file.name}: ${error.message}`, 'error');
            }
        }
    };

    // Set up image upload zone event listeners AFTER function is defined
    document.querySelectorAll('.image-upload-zone').forEach(zone => {
        const fileInput = zone.querySelector('input[type="file"]');
        const imageType = zone.dataset.imageType;

        zone.addEventListener('click', function() {
            fileInput.click();
        });

        zone.addEventListener('dragover', function(e) {
            e.preventDefault();
            zone.style.borderColor = '#2563EB';
            zone.style.backgroundColor = '#DBEAFE';
        });

        zone.addEventListener('dragleave', function() {
            zone.style.borderColor = '#CBD5E1';
            zone.style.backgroundColor = '#F8FAFC';
        });

        zone.addEventListener('drop', function(e) {
            e.preventDefault();
            zone.style.borderColor = '#CBD5E1';
            zone.style.backgroundColor = '#F8FAFC';
            
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                window.handleFileUpload(files, imageType);
            }
        });

        fileInput.addEventListener('change', function(e) {
            if (e.target.files.length > 0) {
                window.handleFileUpload(e.target.files, imageType);
            }
        });
    });

    // Also set up displayUploadedImages as global
    window.displayUploadedImages = displayUploadedImages;

    function displayUploadedImages(imageType) {
        const container = document.querySelector(`.uploaded-images-container[data-type="${imageType}"]`);
        const images = window.uploadedImages[imageType];
        
        if (!container || images.length === 0) {
            if (container) container.innerHTML = '';
            return;
        }

        container.innerHTML = '<div class="mt-2"><strong>Uploaded Images:</strong></div>';
        
        images.forEach((image, index) => {
            const imageCard = document.createElement('div');
            imageCard.className = 'card mt-2';
            
            // Generate preview URL - for private storage we need to use a controller route
            const previewUrl = `/storage/${image.file_path}`;
            
            imageCard.innerHTML = `
                <div class="card-body p-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <img src="${previewUrl}" 
                                 alt="Preview" 
                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px; margin-right: 10px;"
                                 onerror="this.src='/images/no-image.png'; this.onerror=null;">
                            <div>
                                <small class="d-block">${image.original_filename || 'Image ' + (index + 1)}</small>
                                <small class="text-muted">${formatFileSize(image.file_size)}</small>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger delete-image-btn" data-image-id="${image.id}" data-image-type="${imageType}">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(imageCard);
        });
        
        // Attach delete event listeners
        container.querySelectorAll('.delete-image-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const imageId = this.getAttribute('data-image-id');
                const imgType = this.getAttribute('data-image-type');
                window.deleteImage(imageId, imgType);
            });
        });
    }

    // Set up deleteImage function as global BEFORE using it
    window.deleteImage = async function deleteImage(imageId, imageType) {
        const confirmed = await Swal.fire({
            title: 'Are you sure?',
            text: 'Do you want to delete this image?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        });

        if (!confirmed.isConfirmed) return;

        try {
            const response = await fetch(`/api/packaging-standards/${window.packagingStandardId}/delete-image/${imageId}`, {
                method: 'DELETE',
                headers: {
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                }
            });

            const result = await response.json();
            
            if (result.success) {
                // Remove from local array
                window.uploadedImages[imageType] = window.uploadedImages[imageType].filter(img => img.id !== imageId);
                displayUploadedImages(imageType);
                Swal.fire('Deleted!', 'Image has been deleted.', 'success');
            } else {
                Swal.fire('Error', result.message || 'Failed to delete image', 'error');
            }
        } catch (error) {
            console.error('Error deleting image:', error);
            Swal.fire('Error', 'Failed to delete image', 'error');
        }
    };

}); // END FIRST DOMContentLoaded event listener

// ===== MAIN FORM INITIALIZATION =====
// Initialize global state variables
window.packagingStandardId = null;
window.uploadedImages = {
    image_of_packaging: [],
    part_identification_point: []
};

document.addEventListener('DOMContentLoaded', function() {
    console.log('🟢 Main form initialization started');
    
    const token = '{{ $token }}';

    // Initialize materials table
    initializeMaterialsTable();
    
    // Load form data
    loadFormData();

    async function loadFormData() {
        try {
            console.log('Loading form data with token:', token);
            const response = await fetch(`/api/packaging-standards/${token}`);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const result = await response.json();
            
            console.log('API Response:', result);
            
            if (result.success) {
                window.packagingStandardId = result.data.packagingStandardId;
                console.log('✅ PackagingStandardId set to:', window.packagingStandardId);
                
                populateForm(result.data);
                
                // Load existing images
                if (result.data.images) {
                    loadExistingImages(result.data.images);
                }
                
                // Enable buttons
                document.getElementById('saveDraftBtn').disabled = false;
                document.getElementById('submitBtn').disabled = false;
                document.getElementById('formLoadingStatus').innerHTML = '<small class="text-success"><i class="ti ti-check"></i> Form loaded successfully</small>';
                
                // Initialize image upload zones AFTER packagingStandardId is set
                initializeImageUploadZones();
            } else {
                throw new Error(result.error || 'Failed to load form data');
            }
        } catch (error) {
            console.error('Error loading form:', error);
            document.getElementById('formLoadingStatus').innerHTML = '<small class="text-danger"><i class="ti ti-alert-triangle"></i> Failed to load form: ' + error.message + '</small>';
            Swal.fire('Error', 'Failed to load form data: ' + error.message, 'error');
        }
    }

    function loadExistingImages(images) {
        if (images.image_of_packaging && images.image_of_packaging.length > 0) {
            window.uploadedImages.image_of_packaging = images.image_of_packaging;
            displayUploadedImages('image_of_packaging');
        }
        
        if (images.part_identification_point && images.part_identification_point.length > 0) {
            window.uploadedImages.part_identification_point = images.part_identification_point;
            displayUploadedImages('part_identification_point');
        }
    }

    function populateForm(data) {
        console.log('🔵 populateForm called with data:', data);
        
        // Company Logo
        if (data.company_logo) {
            uploadedLogoPath = data.company_logo;
            document.getElementById('logoPreview').innerHTML = `<img src="${data.company_logo}" style="max-height: 150px; max-width: 100%; object-fit: contain;" alt="Company Logo">`;
        }

        // General Information
        if (data.document_no) document.getElementById('document_no').value = data.document_no;
        if (data.revision) document.getElementById('revision').value = data.revision;
        if (data.date) document.getElementById('date').value = data.date;
        if (data.model) document.getElementById('model').value = data.model;
        if (data.part_no) document.getElementById('part_no').value = data.part_no;
        if (data.part_name) document.getElementById('part_name').value = data.part_name;
        if (data.supplier_name) document.getElementById('supplier_name').value = data.supplier_name;
        if (data.qty) document.getElementById('qty').value = data.qty;

        // Packaging Specifications
        if (data.packaging_type) document.getElementById('packaging_type').value = data.packaging_type;
        if (data.packaging_size_mm) document.getElementById('packaging_size_mm').value = data.packaging_size_mm;
        if (data.packaging_lot_pcs_box) document.getElementById('packaging_lot_pcs_box').value = data.packaging_lot_pcs_box;
        if (data.net_weight_g_pc) document.getElementById('net_weight_g_pc').value = data.net_weight_g_pc;
        if (data.total_weight_kg_box) document.getElementById('total_weight_kg_box').value = data.total_weight_kg_box;

        // Load materials
        if (data.materials && Array.isArray(data.materials) && data.materials.length > 0) {
            materials = [];
            data.materials.forEach(mat => {
                materials.push({
                    part_no: mat.part_no || '',
                    part_name: mat.part_name || '',
                    supplier: mat.supplier || '',
                    qty: mat.qty || ''
                });
            });
            while (materials.length < 6) {
                materials.push({
                    part_no: '',
                    part_name: '',
                    supplier: '',
                    qty: ''
                });
            }
            renderMaterialsTable();
        }
    }

    }

    // ===== IMAGE UPLOAD FUNCTIONALITY =====
    function initializeImageUploadZones() {
        console.log('🎨 Initializing image upload zones');
        
        document.querySelectorAll('.image-upload-zone').forEach(zone => {
            const fileInput = zone.querySelector('input[type="file"]');
            const imageType = zone.dataset.imageType;
            
            console.log('🎨 Setting up zone for:', imageType);

            // Click to upload
            zone.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('📁 Zone clicked:', imageType);
                fileInput.click();
            });

            // Drag over
            zone.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.stopPropagation();
                zone.style.borderColor = '#2563EB';
                zone.style.backgroundColor = '#DBEAFE';
            });

            // Drag leave
            zone.addEventListener('dragleave', function(e) {
                e.preventDefault();
                e.stopPropagation();
                zone.style.borderColor = '#CBD5E1';
                zone.style.backgroundColor = '#F8FAFC';
            });

            // Drop
            zone.addEventListener('drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                zone.style.borderColor = '#CBD5E1';
                zone.style.backgroundColor = '#F8FAFC';
                
                const files = e.dataTransfer.files;
                console.log('📥 Files dropped:', files.length, 'Type:', imageType);
                if (files.length > 0) {
                    handleFileUpload(files, imageType);
                }
            });

            // File input change
            fileInput.addEventListener('change', function(e) {
                console.log('📄 File input changed:', e.target.files.length, 'Type:', imageType);
                if (e.target.files.length > 0) {
                    handleFileUpload(e.target.files, imageType);
                }
                // Reset input so same file can be selected again
                e.target.value = '';
            });
        });
        
        console.log('✅ Image upload zones initialized');
    }

    async function handleFileUpload(files, imageType) {
        if (!window.packagingStandardId) {
            Swal.fire('Error', 'Form not initialized. Please refresh the page.', 'error');
            console.error('packagingStandardId is not set');
            return;
        }

        const fileArray = Array.from(files);
        console.log('📤 Uploading files:', fileArray.length, 'Type:', imageType, 'PS ID:', window.packagingStandardId);
        
        for (const file of fileArray) {
            // Validate file
            if (!file.type.match('image/(jpeg|jpg|png)')) {
                Swal.fire('Error', `File ${file.name} is not a valid image format. Please use JPG or PNG.`, 'error');
                continue;
            }
            
            if (file.size > 10 * 1024 * 1024) {
                Swal.fire('Error', `File ${file.name} exceeds 10MB limit`, 'error');
                continue;
            }

            // Show loading
            Swal.fire({
                title: 'Uploading...',
                text: `Uploading ${file.name}`,
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Upload file
            const formData = new FormData();
            formData.append('image', file);
            formData.append('image_type', imageType);

            try {
                const uploadUrl = `/api/packaging-standards/${window.packagingStandardId}/upload-image`;
                console.log('📤 Uploading to:', uploadUrl);
                
                const response = await fetch(uploadUrl, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    body: formData
                });

                const result = await response.json();
                console.log('📥 Upload result:', result);
                
                if (result.success) {
                    // Add to uploaded images array
                    window.uploadedImages[imageType].push(result.image);
                    displayUploadedImages(imageType);
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: `${file.name} uploaded successfully`,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                } else {
                    Swal.fire('Error', result.message || `Failed to upload ${file.name}`, 'error');
                }
            } catch (error) {
                console.error('Error uploading image:', error);
                Swal.fire('Error', `Failed to upload ${file.name}: ${error.message}`, 'error');
            }
        }
    }

    function displayUploadedImages(imageType) {
        const container = document.querySelector(`.uploaded-images-container[data-type="${imageType}"]`);
        const images = window.uploadedImages[imageType];
        
        if (!container) {
            console.error('Container not found for:', imageType);
            return;
        }

        if (images.length === 0) {
            container.innerHTML = '';
            return;
        }

        container.innerHTML = '<div class="mt-2"><strong>Uploaded Images:</strong></div>';
        
        images.forEach((image, index) => {
            const imageCard = document.createElement('div');
            imageCard.className = 'card mt-2';
            
            // Generate preview URL
            const previewUrl = `/storage/${image.file_path}`;
            
            imageCard.innerHTML = `
                <div class="card-body p-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <img src="${previewUrl}" 
                                 alt="Preview" 
                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px; margin-right: 10px;"
                                 onerror="this.src='/images/no-image.png'; this.onerror=null;">
                            <div>
                                <small class="d-block"><strong>${image.original_filename || 'Image ' + (index + 1)}</strong></small>
                                <small class="text-muted">${formatFileSize(image.file_size)}</small>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger delete-image-btn" 
                                data-image-id="${image.id}" data-image-type="${imageType}">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(imageCard);
        });
        
        // Attach delete event listeners
        container.querySelectorAll('.delete-image-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const imageId = this.getAttribute('data-image-id');
                const imgType = this.getAttribute('data-image-type');
                deleteImage(imageId, imgType);
            });
        });
    }

    async function deleteImage(imageId, imageType) {
        const confirmed = await Swal.fire({
            title: 'Are you sure?',
            text: 'Do you want to delete this image?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        });

        if (!confirmed.isConfirmed) return;

        try {
            const deleteUrl = `/api/packaging-standards/${window.packagingStandardId}/delete-image/${imageId}`;
            console.log('🗑️ Deleting from:', deleteUrl);
            
            const response = await fetch(deleteUrl, {
                method: 'DELETE',
                headers: {
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                }
            });

            const result = await response.json();
            
            if (result.success) {
                // Remove from local array
                window.uploadedImages[imageType] = window.uploadedImages[imageType].filter(img => img.id != imageId);
                displayUploadedImages(imageType);
                Swal.fire('Deleted!', 'Image has been deleted.', 'success');
            } else {
                Swal.fire('Error', result.message || 'Failed to delete image', 'error');
            }
        } catch (error) {
            console.error('Error deleting image:', error);
            Swal.fire('Error', 'Failed to delete image: ' + error.message, 'error');
        }
    }

    // ===== FORM SUBMISSION FUNCTIONS =====
    function saveDraft() {
        if (!window.packagingStandardId) {
            Swal.fire('Error', 'Form not fully loaded. Please refresh the page and try again.', 'error');
            return;
        }

        const formData = collectFormData();
        formData.status = 'DRAFT';
        
        const jsonPayload = JSON.stringify(formData);
        console.log('Sending saveDraft payload:', jsonPayload);
        
        fetch(`/api/packaging-standards/${window.packagingStandardId}/draft`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            },
            body: jsonPayload
        }).then(r => {
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            return r.json();
        }).then(result => {
            if (result.success) {
                Swal.fire('Success', 'Draft saved successfully!', 'success');
            } else {
                Swal.fire('Error', result.message || 'Failed to save draft', 'error');
            }
        }).catch(error => {
            console.error('Error saving draft:', error);
            Swal.fire('Error', 'Failed to save draft: ' + error.message, 'error');
        });
    }

    function submitForm() {
        if (!validate()) return;

        // Check if packagingStandardId is available
        if (!window.packagingStandardId) {
            console.error('packagingStandardId is not set');
            Swal.fire('Error', 'Form not fully loaded. Please refresh the page and try again.', 'error');
            return;
        }

        console.log('Submitting form with packagingStandardId:', window.packagingStandardId);

        const formData = collectFormData();
        formData.status = 'SUBMITTED';
        
        const jsonPayload = JSON.stringify(formData);
        console.log('Sending submit payload:', jsonPayload);
        
        fetch(`/api/packaging-standards/${window.packagingStandardId}/submit`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            },
            body: jsonPayload
        }).then(r => {
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            return r.json();
        }).then(result => {
            console.log('Response result:', result);
            
            if (result.success) {
                console.log('✅ Submit successful, redirecting to:', result.redirect);
                Swal.fire('Success', 'Form submitted successfully!', 'success').then(() => {
                    const redirectUrl = result.redirect || '/supplier/dashboard';
                    console.log('🔄 Redirecting to:', redirectUrl);
                    window.location.href = redirectUrl;
                });
            } else {
                const errors = result.errors ? (Array.isArray(result.errors) ? result.errors.join('<br>') : JSON.stringify(result.errors)) : result.message;
                Swal.fire('Validation Error', errors, 'error');
            }
        }).catch(error => {
            console.error('Error submitting form:', error);
            Swal.fire('Error', 'Failed to submit form: ' + error.message, 'error');
        });
    }

    function collectFormData() {
        const getValueSafely = (id) => {
            const element = document.getElementById(id);
            return element ? element.value : '';
        };

        return {
            document_no: getValueSafely('document_no'),
            revision: getValueSafely('revision'),
            date: getValueSafely('date'),
            part_no: getValueSafely('part_no'),
            part_name: getValueSafely('part_name'),
            supplier_name: getValueSafely('supplier_name'),
            qty: getValueSafely('qty'),
            packaging_type: getValueSafely('packaging_type'),
            packaging_size_mm: getValueSafely('packaging_size_mm'),
            packaging_lot_pcs_box: getValueSafely('packaging_lot_pcs_box'),
            net_weight_g_pc: getValueSafely('net_weight_g_pc'),
            total_weight_kg_box: getValueSafely('total_weight_kg_box'),
            company_logo: uploadedLogoPath,
            materials: materials,
        };
    }

    function validate() {
        const required = ['document_no', 'revision', 'date', 'part_no', 'part_name', 'qty', 
                          'packaging_type', 'packaging_size_mm', 'packaging_lot_pcs_box'];
        const errors = [];

        required.forEach(field => {
            const element = document.getElementById(field);
            if (!element) {
                console.warn(`Element with id "${field}" not found`);
                return;
            }
            
            if (!element.value || !element.value.trim()) {
                const label = document.querySelector(`label[for="${field}"]`);
                const fieldName = label ? label.textContent.replace(' *', '').trim() : field;
                errors.push(`${fieldName} is required`);
                element.classList.add('is-invalid');
            } else {
                element.classList.remove('is-invalid');
            }
        });

        if (errors.length > 0) {
            Swal.fire('Validation Error', errors.join('<br>'), 'error');
            return false;
        }

        return true;
    }

    // Expose functions to global scope
    window.saveDraft = saveDraft;
    window.submitForm = submitForm;
    window.validate = validate;
    window.collectFormData = collectFormData;
}); // END DOMContentLoaded event listener
</script>

