                    </div>

                    <!-- Image - Part Identification Point -->
                    <div class="col-md-6 mb-4">
                        <label class="form-label">Part Identification Point</label>
                        <div class="image-upload-zone mb-2" data-image-type="part_identification_point">
                            <input type="file" class="form-control d-none" name="images_part_identification[]" accept="image/jpeg,image/png" data-image-type="part_identification_point" multiple>
                            <div class="upload-placeholder">
                                <i class="ti ti-photo-plus fs-1"></i>
                                <p class="mb-0">Click to upload or drag images</p>
                                <small>JPG or PNG, max 10MB per file, multiple files allowed</small>
